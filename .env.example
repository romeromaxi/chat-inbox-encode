COMPOSE_PROJECT_NAME=chat-inbox-encode

WEB_PORT=8080
API_PORT=5080

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DATABASE=chat_inbox
POSTGRES_USER=chat_inbox
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

RABBITMQ_IMAGE=rabbitmq:4-management-alpine
RABBITMQ_USER=chat_inbox
RABBITMQ_PASSWORD=replace-with-a-local-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

NGINX_IMAGE=nginx:1.28-alpine
NGROK_IMAGE=ngrok/ngrok:3-alpine
NGROK_AUTHTOKEN=replace-with-your-ngrok-authtoken
NGROK_RESERVED_URL=https://replace-with-your-reserved-domain.ngrok.app

TELEGRAM_BOT_TOKEN=replace-with-your-botfather-token
TELEGRAM_WEBHOOK_SECRET_TOKEN=replace-with-a-random-secret-token

